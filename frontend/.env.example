# Supabase Configuration
# Replace with your actual Project URL & anon key from Supabase Dashboard (Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL (FastAPI)
# Set this to your deployed backend URL when ready (e.g., https://your-app.onrender.com)
# For local development, keep as http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api
